# Please create a .env file and copy these variables into it.
# To use Gmail, you need to turn on 2-step verification and generate an "App Password".
# Example: EMAIL_USER=your_email@gmail.com
# Example: EMAIL_PASS=abcd efgh ijkl mnop
PORT=3000

# Put your actual credentials in the .env file, NEVER commit them to GitHub!
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
MONGO_URI=your_mongodb_connection_string
CRON_SECRET_KEY=your_secret_key_here
